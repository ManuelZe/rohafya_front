# =============================================================================
#  Variables de la stack ROHAFYA — à saisir dans Portainer
#  Stacks > rohafya-production > Editor > Environment variables > « Advanced mode »,
#  puis coller ce contenu en adaptant les valeurs.
#  NE JAMAIS committer une copie de ce fichier contenant de vraies valeurs.
# =============================================================================

# Environnement : production | preprod  (sert au nommage du conteneur)
ROHAFYA_ENV=production

# Image et VERSION déployée = tag Git sans le « v » (v1.4.2 -> 1.4.2)
ROHAFYA_IMAGE=ghcr.io/pdmdsante/rohafya
ROHAFYA_VERSION=1.0.0

# API Flask appelée par le navigateur — HTTPS et « / » final obligatoires
API_URL=https://api.rohafya.com/

# Domaine(s) public(s) de ROHAFYA, séparés par des virgules (protection SSRF du rendu serveur)
ROHAFYA_DOMAINS=rohafya.com

# Port publié sur 127.0.0.1 du serveur (préprod : 4001 pour éviter le conflit)
ROHAFYA_HTTP_PORT=4000

TZ=Africa/Douala
