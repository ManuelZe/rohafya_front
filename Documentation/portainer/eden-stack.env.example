# =============================================================================
#  Variables de la stack EDEN — à saisir dans Portainer
#  Stacks > eden-production > Editor > Environment variables > « Advanced mode »,
#  puis coller ce contenu en adaptant les valeurs.
#  NE JAMAIS committer une copie de ce fichier contenant de vraies valeurs.
# =============================================================================

# Environnement : production | preprod  (sert au nommage du conteneur)
EDEN_ENV=production

# Image et VERSION déployée = tag Git sans le « v » (v1.4.2 -> 1.4.2)
EDEN_IMAGE=ghcr.io/pdmdsante/eden-app
EDEN_VERSION=1.0.0

# API Flask appelée par le navigateur — HTTPS et « / » final obligatoires
API_URL=https://site.pdmdsante.com/

# Domaine(s) public(s) d'EDEN, séparés par des virgules (protection SSRF du rendu serveur)
EDEN_DOMAINS=eden.pdmdsante.com

# Port publié sur 127.0.0.1 du serveur (préprod : 4001 pour éviter le conflit)
EDEN_HTTP_PORT=4000

TZ=Africa/Douala
